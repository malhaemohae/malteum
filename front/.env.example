# Next.js 서버가 REST 요청을 백엔드로 프록시할 주소입니다.
MALTEUM_BACKEND_URL=http://127.0.0.1:8000

# 브라우저가 직접 연결할 WebSocket 주소입니다.
NEXT_PUBLIC_MALTEUM_WS_URL=ws://127.0.0.1:8000/ws

# 별도 프록시를 쓰는 배포 환경에서만 지정합니다. 기본값은 /api 입니다.
# NEXT_PUBLIC_MALTEUM_API_BASE_URL=/api
# 로컬에서도 REST는 Next의 same-origin 프록시(`/api`)를 사용합니다.
# 직접 API origin을 지정하면 백엔드 CORS 설정이 별도로 필요합니다.
# 관리자 토큰은 기준 관리 → 관리자 인증에서 입력합니다.
# NEXT_PUBLIC_* 변수에 비밀 키를 넣으면 브라우저 번들에 공개되므로 넣지 않습니다.
