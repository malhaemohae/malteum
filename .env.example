# docker compose 변수. 복사해서 .env 로.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
SERVER_PORT=8000

# back/ 로컬 실행용 (APP_ 접두어). 이 파일(루트 .env)에서 읽고, back/.env 가 있으면 그쪽이 덮어쓴다
# APP_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# APP_PACK_DIR=./contracts/fixtures
# APP_EXTRACTION_DIR=../assets/extraction    # 구조 추출 덤프. scripts/dump_extraction.py 가 만든다
# APP_WS_PING_INTERVAL_S=30

# 실물 어댑터. LLM_MODEL 이 비면 refine 생략, EMBEDDING_MODEL 이 비면 L2 생략
# APP_LLM_PROVIDER=openrouter                # LiteLLM provider: openrouter · anthropic · openai …
# APP_LLM_API_KEY=sk-or-...
# APP_LLM_MODEL=qwen/qwen3-32b               # provider 공홈 모델명 그대로 (tool calling 지원 모델)
# APP_LLM_NO_REASONING=true                  # Qwen 등 thinking 기본 모델은 켜야 함 (tool_choice·지연)
# APP_LLM_CORRECTOR=true                     # refine 앞 STT 용어 교정 (LLM 1회 추가)
# APP_LLM_GENERATOR=true                     # answer 문장 생성 (P4 guard 가 근거 밖 문장을 거른다)
# APP_EMBEDDING_MODEL=intfloat/multilingual-e5-small   # 로컬(sentence-transformers), M3 팩 발행과 동일. 켜면 L2 동작
# APP_EMBEDDING_DIM=384                      # 팩의 embedding.dim 과 같아야 load_pack 이 받는다
# APP_EMBEDDING_BACKEND=local                # local | litellm (API 임베딩이 필요할 때만 litellm)
# APP_L3_BUDGET_MS=3000                      # refine 예산. 기본 3초. OpenRouter 왕복 실측(2~5초)에 맞췄다

# 쓰기 경로 토큰 (계약 securitySchemes). 팩 발행·문서 업로드·후보 승인에만.
# 비면 그 경로들이 401 이고 부팅 로그가 그렇게 말한다. 조회·세션 시작은 토큰 없이
# 열려 있어(계약) 심사 기본 경로(기획 10.1)는 토큰 없이도 전부 돈다.
#
# 값을 만든다:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# 사람이 지은 문자열을 쓰지 않는다 — 이 토큰 하나가 팩 발행 전체의 문턱이고,
# 팩은 불변 발행물이라 잘못 들어간 버전을 지울 수 없다.
# APP_ADMIN_TOKEN=...

# 외부 감시 알림 (back/scripts/watch_health.py). Slack·Discord·ntfy 의 수신 URL.
# 서버가 아니라 **감시를 돌리는 기계**의 환경변수다 — 서버에 넣어도 아무 일도 안 한다.
# 비면 표준오류로만 적는다
# HEALTH_ALERT_WEBHOOK=https://hooks.slack.com/...

# STT. 비면 오디오 층이 빠지고 ws 가 stt_unavailable 을 낸다 (3층 폴백, 기획 7.1 ⑪).
# 리스크 6 상 키·잔량 관리는 R2 담당. 검증은 scripts/stt_check.py --make-audio
# APP_STT_API_KEY=...                        # Deepgram 콘솔 API Keys. 40자 hex (Project ID 아님)
# APP_STT_MODEL=nova-3                       # 기획 11.3. 한국어 적중 8/8 실측 (2026-09-02)
# APP_STT_LANGUAGE=ko
# APP_STT_MIP_OPT_OUT=true                   # 13장이 라이선스 조건으로 정한 학습 사용 거부. 기본 켬

# 전사 공급자. deepgram(기본) 은 스트리밍이고 위의 APP_STT_API_KEY 를 쓴다.
# openai_file 은 온프레미스 경로다 — 화자 분리 구간마다 WAV 하나를
# {APP_STT_BASE_URL}/v1/audio/transcriptions 에 보낸다(OpenAI 규격). 끊을 자리를
# 구간에서 얻으므로 APP_DIARIZATION_URL 이 함께 있어야 하고, 없으면 부팅이 오디오 층을
# 아예 만들지 않아 ws 가 stt_unavailable 을 낸다.
# Qwen3-ASR 은 자르지 않고 연속으로 넣으면 CER 이 31 %까지 무너져 이 구조가 필수다(실측)
# APP_STT_PROVIDER=openai_file               # openai_file | deepgram | openai_realtime
#
# openai_realtime: Realtime WebSocket 스트리밍(1차 MVP 합의). 오디오를 계속 밀어 넣고
#   서버 VAD 가 끊는다. 이 규격은 화자를 안 주므로 APP_DIARIZATION_URL 이 함께 있어야
#   teller·customer 가 갈린다 — 없으면 확정 발화가 전부 teller 로 기록된다.
#   공개 주소면 APP_STT_API_KEY 가 필요하고, APP_STT_BASE_URL 로 같은 규격의 로컬
#   서버에도 붙는다. 모델 기본값은 gpt-live-transcribe
# APP_STT_BASE_URL=http://127.0.0.1:8100     # qwen-asr-serve (vLLM). OpenAI 면 https://api.openai.com + APP_STT_MODEL=gpt-4o-transcribe + APP_STT_API_KEY
# APP_STT_MODEL=Qwen/Qwen3-ASR-1.7B          # openai_file 일 때. deepgram 이면 nova-3

# 화자 분리 사이드카 (back/sidecar/diarization/). 비면 화자 분리 공급원이 없고,
# 발화는 예전대로 teller 고정에 speaker_confidence 는 계약 기본값(None)으로 나간다
# APP_DIARIZATION_URL=ws://127.0.0.1:8300/ws

# APP_SPEAKER_ROLE_JUDGE=false               # 화자 분리 번호 → teller·customer 매핑을 LLM 에 묻는다.
#                                            # 기본 켬. APP_LLM_MODEL 설정을 그대로 쓰므로 그것이
#                                            # 비면 규칙 폴백(신뢰도 낮음)이다. 끄면 LLM 이 있어도 폴백
# APP_SPEAKER_HOLD_MS=3000                   # DEC-7. 새 화자 번호의 발화를 역할이 확정될 때까지
#                                            # 붙잡는 상한. 넘기면 잠정 라벨(신뢰도 0.2)로 내보낸다.
#                                            # 0 이면 붙잡지 않는다 — 새 번호의 첫 발화에 걸린
#                                            # 필수 고지·위험 신호 판정이 게이트에 접힌다
