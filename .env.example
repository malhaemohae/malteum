# docker compose 변수. 복사해서 .env 로.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
SERVER_PORT=8000

# back/ 로컬 실행용 (APP_ 접두어). 이 파일(루트 .env)에서 읽고, back/.env 가 있으면 그쪽이 덮어쓴다
# APP_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# APP_PACK_DIR=./contracts/fixtures
# APP_WS_PING_INTERVAL_S=30

# 실물 어댑터. LLM_MODEL 이 비면 refine 생략, EMBEDDING_MODEL 이 비면 L2 생략
# APP_LLM_PROVIDER=openrouter                # LiteLLM provider: openrouter · anthropic · openai …
# APP_LLM_API_KEY=sk-or-...
# APP_LLM_MODEL=qwen/qwen3-32b               # provider 공홈 모델명 그대로 (tool calling 지원 모델)
# APP_LLM_NO_REASONING=true                  # Qwen 등 thinking 기본 모델은 켜야 함 (tool_choice·지연)
# APP_LLM_CORRECTOR=true                     # refine 앞 STT 용어 교정 (LLM 1회 추가)
# APP_LLM_GENERATOR=true                     # answer 문장 생성 (P4 guard 가 근거 밖 문장을 거른다)
# APP_EMBEDDING_MODEL=baai/bge-m3            # OpenRouter 제공 다국어 임베딩 (dim 1024). e5-small 은 OpenRouter 에 없다
# APP_EMBEDDING_DIM=1024                     # 팩의 embedding.dim 과 같아야 load_pack 이 받는다 (현재 팩은 384 → M3 재발행 필요)
# APP_L3_BUDGET_MS=1500                      # refine 예산. OpenRouter 는 2~5초 걸리므로 실측 중엔 키운다
