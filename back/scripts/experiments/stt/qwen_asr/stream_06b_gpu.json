   {
    "seg_start": 36.72,
    "audio_end_s": 40.4,
    "accum_s": 3.68,
    "lat_s": 0.13256311416625977,
    "text": "금리가 5를 변동 가능성이 있습니다."
   },
   {
    "seg_start": 41.84,
    "audio_end_s": 43.84,
    "accum_s": 2.0,
    "lat_s": 0.12287425994873047,
    "text": "지금 조회한 조건이면 연사점"
