  "steps": [
   {
    "seg_start": 3.04,
    "audio_end_s": 4.16,
    "accum_s": 1.12,
    "lat_s": 0.6668910980224609,
    "text": "안녕하세요."
   },
   {
    "seg_start": 4.88,
    "audio_end_s": 6.88,
    "accum_s": 2.0,
    "lat_s": 0.09581518173217773,
    "text": "작년에 넣어둔."
   },
   {
    "seg_start": 4.88,
    "audio_end_s": 8.48,
    "accum_s": 3.6,
    "lat_s": 0.1548914909362793,
    "text": "작년에 넣어둔 정기예금이 있는데."
   },
   {
    "seg_start": 8.8,
    "audio_end_s": 10.8,
    "accum_s": 2.0,
    "lat_s": 0.08315300941467285,
    "text": "망기가 아직 안 됐."
   },
   {
    "seg_start": 8.8,
    "audio_end_s": 11.440000000000001,
    "accum_s": 2.64,
    "lat_s": 0.09362411499023438,
    "text": "망기가 아직 안 됐거든요."
   },
   {
    "seg_start": 12.0,
    "audio_end_s": 14.0,
    "accum_s": 2.0,
    "lat_s": 0.0736703872680664,
    "text": "지금 해지하면."
   },
   {
    "seg_start": 12.0,
    "audio_end_s": 15.68,
    "accum_s": 3.68,
    "lat_s": 0.1318521499633789,
    "text": "지금 해지하면 얼마나 받을 수 있어요?"
   },
   {
    "seg_start": 41.92,
    "audio_end_s": 42.480000000000004,
    "accum_s": 0.56,
    "lat_s": 0.08387422561645508,
    "text": "네."
   },
   {
    "seg_start": 42.64,
    "audio_end_s": 44.56,
    "accum_s": 1.92,
    "lat_s": 0.12325239181518555,
    "text": "중도 해지율이 뭐예요?"
   },
   {
    "seg_start": 55.6,
    "audio_end_s": 57.6,
    "accum_s": 2.0,
    "lat_s": 0.09506034851074219,
    "text": "아, 중간에 깨면"
   },
   {
    "seg_start": 55.6,
    "audio_end_s": 59.6,
    "accum_s": 4.0,
    "lat_s": 0.1940600872039795,
    "text": "아, 중간에 깨면 이자를 훨씬 덜 받."
   },
   {
    "seg_start": 55.6,
    "audio_end_s": 60.88,
    "accum_s": 5.28,
    "lat_s": 0.1031954288482666,
    "text": "아, 중간에 깨면 이자를 훨씬 덜 받는다는 거네요."
   },
   {
    "seg_start": 71.28,
    "audio_end_s": 73.28,
    "accum_s": 2.0,
    "lat_s": 0.06440091133117676,
    "text": "그래요 그럼 그냥."
   },
   {
    "seg_start": 71.28,
    "audio_end_s": 75.12,
    "accum_s": 3.84,
    "lat_s": 0.1328141689300537,
    "text": "그래요 그럼 그냥 두는 게 낫겠네요."
   },
   {
    "seg_start": 127.76,
    "audio_end_s": 129.76,
    "accum_s": 2.0,
    "lat_s": 0.1117861270904541,
    "text": "아니요 그냥 해지할게요."
   },
   {
    "seg_start": 127.76,
    "audio_end_s": 129.84,
    "accum_s": 2.08,
    "lat_s": 0.11154794692993164,
    "text": "아니요 그냥 해지할게요."
   },
   {
    "seg_start": 130.64,
    "audio_end_s": 131.60006249999998,
    "accum_s": 0.9600625,
    "lat_s": 0.08190202713012695,
    "text": "해지한 돈은."
   },
   {
    "seg_start": 131.84,
    "audio_end_s": 133.84,
    "accum_s": 2.0,
    "lat_s": 0.10206985473632812,
    "text": "딸이 알려준 계좌로 바로."
   },
   {
    "seg_start": 131.84,
    "audio_end_s": 134.96,
    "accum_s": 3.12,
    "lat_s": 0.12098360061645508,
    "text": "딸이 알려준 계좌로 바로 보내주세요."
   },
   {
    "seg_start": 17.36,
    "audio_end_s": 19.36,
    "accum_s": 2.0,
    "lat_s": 0.16072797775268555,
    "text": "네 중도 해지 기준으로 안내 드리겠습니다."
   },
   {
    "seg_start": 17.36,
    "audio_end_s": 21.36,
    "accum_s": 4.0,
    "lat_s": 0.2567126750946045,
    "text": "네 중도 해지 기준으로 안내드리겠습니다. 우대 이자율은 중도 해지 하시"
   },
   {
    "seg_start": 17.36,
    "audio_end_s": 23.36,
    "accum_s": 6.0,
    "lat_s": 0.12417054176330566,
    "text": "네 중도 해지 기준으로 안내드리겠습니다. 우대 이자율은 중도 해지하시면은 적용이 안되고."
   },
   {
    "seg_start": 17.36,
    "audio_end_s": 25.36,
    "accum_s": 8.0,
    "lat_s": 0.16740655899047852,
    "text": "네 중도 해지 기준으로 안내드리겠습니다. 우대 이자율은 중도 해지하시면은 적용이 안되고 기본 이자율 기준으로 계산됩니다."
   },
   {
    "seg_start": 17.36,
    "audio_end_s": 25.6,
    "accum_s": 8.24,
    "lat_s": 0.06630492210388184,
    "text": "네 중도 해지 기준으로 안내드리겠습니다. 우대 이자율은 중도 해지하시면은 적용이 안되고 기본 이자율 기준으로 계산됩니다."
   },
   {
    "seg_start": 27.04,
    "audio_end_s": 29.04,
    "accum_s": 2.0,
    "lat_s": 0.1505908966064453,
    "text": "받으시는 이자 수익에는 과세가."
   },
   {
    "seg_start": 27.04,
    "audio_end_s": 31.04,
    "accum_s": 4.0,
    "lat_s": 0.24743103981018066,
    "text": "받으시는 이자 수익에는 과세가 되는데요. 세율은 십사."
   },
   {
    "seg_start": 27.04,
    "audio_end_s": 31.599999999999998,
    "accum_s": 4.56,
    "lat_s": 0.17112517356872559,
    "text": "받으시는 이자 수익에는 과세가 되는데요. 세율은 십사 퍼센트입니다."
   },
   {
    "seg_start": 35.84,
    "audio_end_s": 37.84,
    "accum_s": 2.0,
    "lat_s": 0.1610262393951416,
    "text": "그리고 중도 해지 하시면은 중도 해지"
   },
   {
    "seg_start": 35.84,
    "audio_end_s": 39.84,
    "accum_s": 4.0,
    "lat_s": 0.28024983406066895,
    "text": "그리고 중도 해지 하시면은 중도 해지 이율이 적용돼서 이자가 많이 줄어"
   },
   {
    "seg_start": 35.84,
    "audio_end_s": 40.400000000000006,
    "accum_s": 4.56,
    "lat_s": 0.09598326683044434,
    "text": "그리고 중도 해지 하시면은 중도 해지 이율이 적용돼서 이자가 많이 줄어듭니다."
   },
   {
    "seg_start": 49.2,
    "audio_end_s": 51.2,
    "accum_s": 2.0,
    "lat_s": 0.13302874565124512,
    "text": "네, 만기 전에 찾으시면은."
   },
   {
    "seg_start": 49.2,
    "audio_end_s": 53.2,
    "accum_s": 4.0,
    "lat_s": 0.25931453704833984,
    "text": "네, 만기 전에 찾으시면은 처음 약속한 이자보다 적게 받으신."
   },
   {
    "seg_start": 49.2,
    "audio_end_s": 54.24,
    "accum_s": 5.04,
    "lat_s": 0.11337542533874512,
    "text": "네, 만기 전에 찾으시면은 처음 약속한 이자보다 적게 받으신다는 뜻입니다."
   },
   {
    "seg_start": 62.48,
    "audio_end_s": 64.47999999999999,
    "accum_s": 2.0,
    "lat_s": 0.14136385917663574,
    "text": "만기 지나도 금리가 그대로 유지."
   },
   {
    "seg_start": 62.48,
    "audio_end_s": 65.36,
    "accum_s": 2.88,
    "lat_s": 0.1623225212097168,
    "text": "만기 지나도 금리가 그대로 유지되니까."
   },
   {
    "seg_start": 65.68,
    "audio_end_s": 67.04,
    "accum_s": 1.36,
    "lat_s": 0.10219120979309082,
    "text": "그냥 두셔도 돼요."
   },
   {
    "seg_start": 76.64,
    "audio_end_s": 77.6,
    "accum_s": 0.96,
    "lat_s": 0.08633589744567871,
    "text": "아 죄송합니다."
   },
   {
    "seg_start": 77.68,
    "audio_end_s": 79.36000000000001,
    "accum_s": 1.68,
    "lat_s": 0.11296844482421875,
    "text": "정확히 다시 말씀드릴게요."
   },
   {
    "seg_start": 79.76,
    "audio_end_s": 80.88000000000001,
    "accum_s": 1.12,
    "lat_s": 0.05487203598022461,
    "text": "만기 후에는"
   },
   {
    "seg_start": 81.28,
    "audio_end_s": 83.28,
    "accum_s": 2.0,
    "lat_s": 0.09269928932189941,
    "text": "약전 기율이 아니라 만기"
   },
   {
    "seg_start": 81.28,
    "audio_end_s": 84.8,
    "accum_s": 3.52,
    "lat_s": 0.17174363136291504,
    "text": "약전 기율이 아니라 만기 후 이 자율이 적용되고."
   },
   {
    "seg_start": 84.96,
    "audio_end_s": 86.96,
    "accum_s": 2.0,
    "lat_s": 0.14166569709777832,
    "text": "경과 기간에 따라 더 낮아집니다."
   },
   {
    "seg_start": 84.96,
    "audio_end_s": 87.11999999999999,
    "accum_s": 2.16,
    "lat_s": 0.1416165828704834,
    "text": "경과 기간에 따라 더 낮아집니다."
   },
   {
    "seg_start": 88.72,
    "audio_end_s": 90.24,
    "accum_s": 1.52,
    "lat_s": 0.10396742820739746,
    "text": "아까 세금도 정정하겠습니다."
   },
   {
    "seg_start": 90.64,
    "audio_end_s": 92.56,
    "accum_s": 1.92,
    "lat_s": 0.11208200454711914,
    "text": "이제 과세되는 세율은."
   },
   {
    "seg_start": 92.88,
    "audio_end_s": 94.88,
    "accum_s": 2.0,
    "lat_s": 0.11332488059997559,
    "text": "15점사 퍼센트."
   },
   {
    "seg_start": 92.88,
    "audio_end_s": 95.19999999999999,
    "accum_s": 2.32,
    "lat_s": 0.12361311912536621,
    "text": "15점사 퍼센트입니다."
   },
   {
    "seg_start": 96.72,
    "audio_end_s": 98.16,
    "accum_s": 1.44,
    "lat_s": 0.1157846450805664,
    "text": "그리고 중도 해지 이후는."
   },
   {
    "seg_start": 98.48,
    "audio_end_s": 100.48,
    "accum_s": 2.0,
    "lat_s": 0.15453219413757324,
    "text": "약전 기율의 예측 기간별 차감률."
   },
   {
    "seg_start": 98.48,
    "audio_end_s": 101.92,
    "accum_s": 3.44,
    "lat_s": 0.23014497756958008,
    "text": "약정 기율의 예측 기간별 차감율을 곱해서 계산되는데."
   },
   {
    "seg_start": 102.24,
    "audio_end_s": 103.83999999999999,
    "accum_s": 1.6,
    "lat_s": 0.10284662246704102,
    "text": "석달 안에 해지하시면은"
   },
   {
    "seg_start": 104.32,
    "audio_end_s": 106.32,
    "accum_s": 2.0,
    "lat_s": 0.15051841735839844,
    "text": "약정 기율의 절반 정도만 받으세요."
   },
   {
    "seg_start": 104.32,
    "audio_end_s": 106.39999999999999,
    "accum_s": 2.08,
    "lat_s": 0.1520237922668457,
    "text": "약정 기율의 절반 정도만 받으세요."
   },
   {
    "seg_start": 107.92,
    "audio_end_s": 109.92,
    "accum_s": 2.0,
    "lat_s": 0.12235236167907715,
    "text": "대신 해지하지 않고 예금담보대출"
   },
   {
    "seg_start": 107.92,
    "audio_end_s": 110.96000000000001,
    "accum_s": 3.04,
    "lat_s": 0.17067861557006836,
    "text": "대신 해지하지 않고 예금담보대출을 이용하시면."
   },
   {
    "seg_start": 111.28,
    "audio_end_s": 113.28,
    "accum_s": 2.0,
    "lat_s": 0.09315037727355957,
    "text": "예금은 그대로 두고 필요"
   },
   {
    "seg_start": 111.28,
    "audio_end_s": 115.04,
    "accum_s": 3.76,
    "lat_s": 0.21074795722961426,
    "text": "예금은 그대로 두고 필요한 금액만 빌리실 수 있습니다."
   },
   {
    "seg_start": 116.64,
    "audio_end_s": 118.64,
    "accum_s": 2.0,
    "lat_s": 0.12171220779418945,
    "text": "참고로 이 예금은 예금자 보"
   },
   {
    "seg_start": 116.64,
    "audio_end_s": 119.6,
    "accum_s": 2.96,
    "lat_s": 0.1702895164489746,
    "text": "참고로 이 예금은 예금자 보호법에 따라."
   },
   {
    "seg_start": 119.84,
    "audio_end_s": 121.84,
    "accum_s": 2.0,
    "lat_s": 0.11302757263183594,
    "text": "원금과 이자 포함 일 인당."
   },
   {
    "seg_start": 119.84,
    "audio_end_s": 123.52000000000001,
    "accum_s": 3.68,
    "lat_s": 0.20067238807678223,
    "text": "원금과 이자 포함 1인당 1억 원까지 보호됩니다."
   },
   {
    "seg_start": 139.44,
    "audio_end_s": 141.44,
    "accum_s": 2.0,
    "lat_s": 0.13164758682250977,
    "text": "고객님, 어 혹시 딸님과 직접"
   },
   {
    "seg_start": 139.44,
    "audio_end_s": 142.72,
    "accum_s": 3.28,
    "lat_s": 0.20278024673461914,
    "text": "고객님, 어 혹시 딴님과 직접 통화는 해보셨어요"
   },
   {
    "seg_start": 143.2,
    "audio_end_s": 145.2,
    "accum_s": 2.0,
    "lat_s": 0.13228416442871094,
    "text": "확인 후에 진행하겠습니다. 신분증 먼저."
   },
   {
    "seg_start": 143.2,
    "audio_end_s": 146.0,
    "accum_s": 2.8,
    "lat_s": 0.1720876693725586,
    "text": "확인 후에 진행하겠습니다. 신분증 먼저 주시겠어요."
   }
  ]
 },
