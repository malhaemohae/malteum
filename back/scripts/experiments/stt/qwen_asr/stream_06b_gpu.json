   },
   {
    "seg_start": 60.56,
    "audio_end_s": 62.56,
    "accum_s": 2.0,
    "lat_s": 0.139556884765625,
    "text": "금리와 한도가 달라질 수 있습니다."
   },
   {
    "seg_start": 60.56,
    "audio_end_s": 62.72,
    "accum_s": 2.16,
    "lat_s": 0.14035844802856445,
    "text": "금리와 한도가 달라질 수 있습니다."
   },
